# ==========================================
# INDIAN BATTLE FIELDS - backend configuration
# ==========================================
# Copy to .env and fill in. Never commit the real .env.

# ---------- Server ----------
PORT=5000
# "production" turns on production safety checks.
NODE_ENV=development

# Game client URL(s) allowed to connect, comma-separated.
# Required in production. Example:
#   CLIENT_URL=https://play.example.com,https://www.example.com
CLIENT_URL=

# ---------- Supabase ----------
SUPABASE_URL=https://your-project.supabase.co
# Secret (service role) key: backend only, never in a client.
SUPABASE_SECRET_KEY=
# Publishable (anon) key: used only for Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=

# ---------- Accounts ----------
# "true" skips email verification on sign-up (development).
# Use "false" in production.
AUTO_CONFIRM_EMAIL=false
# Where the password-reset email link should open (your
# client's reset page). Optional.
PASSWORD_RESET_REDIRECT_URL=

# ---------- Error reporting ----------
# Webhook that receives crashes and failed saves as JSON
# (a Discord or Slack incoming webhook works). Optional.
ERROR_WEBHOOK_URL=

# ---------- Multiple servers (optional) ----------
# Set both on every server to run more than one. Needs
# database/migrations/005_multi_server.sql. Leave empty for
# a single server.
SERVER_ID=
# Public address clients use for this server's game socket,
# e.g. https://game-1.example.com
SERVER_PUBLIC_URL=

# ---------- Bots ----------
# "true" fills quick matches that are short of players with
# server-controlled bots after the lobby wait.
BOTS_ENABLED=false
# Players a quick match is filled up to (2-150, default 8).
BOT_FILL_TARGET=8

# ---------- Testing (development only) ----------
# Enables dev-prepare-combat-test and dev-teleport socket
# events used by tests/e2e and tests/load. Ignored when
# NODE_ENV=production.
ENABLE_DEV_TEST_EVENTS=false
# Speeds up the safe zone, e.g. 0.02 = 50x faster. Leave
# empty for normal speed.
SAFE_ZONE_TIME_SCALE=
# Milliseconds a disconnected player has to reconnect before
# being eliminated (default 90000).
RECONNECT_GRACE_MS=
